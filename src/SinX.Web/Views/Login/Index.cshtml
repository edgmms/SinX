@model SinX.Web.ViewModels.Account.LoginInputModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SinX.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["LoginTitle"].Value;
}

<section class="auth-card" aria-labelledby="login-title">
    <div class="auth-brand" aria-label="SinX">
        <span class="brand-icon" aria-hidden="true">S</span>
        <span class="brand-name">SinX</span>
    </div>
    <h1 id="login-title" class="auth-title">@Localizer["LoginHeading"]</h1>
    <p class="auth-subtitle">@Localizer["LoginSubtitle"]</p>

    <form action="@Url.Action("Index", "Login")" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-group">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" value="" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <button class="btn btn-primary sinx-submit" type="submit">@Localizer["SignIn"]</button>
    </form>
</section>
