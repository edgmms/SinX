<!DOCTYPE html>
<html lang="tr">
@inject Microsoft.Extensions.Localization.IStringLocalizer<SinX.Web.SharedResource> Localizer
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SinX</title>
    <link rel="stylesheet" href="~/vendor/gentelella/main-v4-DB_ReeJG.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-auth.css" asp-append-version="true" />
</head>
<body class="sinx-public-shell">
    <a class="skip-link" href="#main-content">@Localizer["SkipToContent"]</a>
    <form class="culture-selector" action="/culture" method="post">
        @Html.AntiForgeryToken()
        <input name="returnUrl" type="hidden" value="@Context.Request.PathBase@Context.Request.Path@Context.Request.QueryString" />
        <label for="culture">@Localizer["Language"]</label>
        <select id="culture" name="culture" onchange="this.form.submit()">
            <option value="tr-TR" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "tr-TR")">Türkçe</option>
            <option value="en-US" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US")">English</option>
        </select>
        <button type="submit">@Localizer["ChangeLanguage"]</button>
    </form>
    @if (!Context.Request.IsHttps)
    {
        <p class="transport-warning" role="alert">
            @Localizer["HttpWarning"]
        </p>
    }
    <main id="main-content" class="auth-page" role="main">
        @RenderBody()
    </main>
</body>
</html>
