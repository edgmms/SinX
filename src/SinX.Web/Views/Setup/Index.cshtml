@model SinX.Web.ViewModels.Setup.SetupInputModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SinX.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["SetupTitle"].Value;
}

<section class="auth-card" aria-labelledby="setup-title">
    <div class="auth-brand" aria-label="SinX">
        <span class="brand-icon" aria-hidden="true">S</span>
        <span class="brand-name">SinX</span>
    </div>
    <h1 id="setup-title" class="auth-title">@Localizer["SetupHeading"]</h1>
    <p class="auth-subtitle">@Localizer["SetupSubtitle"]</p>

    <form action="@Url.Action("Index", "Setup")" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-group">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" value="" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" value="" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
        <button class="btn btn-primary sinx-submit" type="submit">@Localizer["CompleteSetup"]</button>
    </form>
</section>
